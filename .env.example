# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE CONFIGURATION (Generated securely in firebase-applet-config.json):
# Client-side configuration generated automatically by ProvisionFirebase RPC.
# Never place service account private keys or server-side private credentials here.
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0930743897"
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0930743897.firebaseapp.com"
VITE_FIREBASE_DATABASE_ID="ai-studio-sakimdigitalpans-a210b445-b014-41a4-9189-dbdf3861baf9"

# REAL AUTHENTICATION & THIRD-PARTY PROVIDER KEYS:
# VITE_GOOGLE_CLIENT_ID: Google OAuth 2.0 Web Client ID for real Google Sign-In.
# Obtain from Google Cloud Console > APIs & Services > Credentials.
VITE_GOOGLE_CLIENT_ID=""

# SMS_GATEWAY_API_KEY: Provider API Key (Fast2SMS / Twilio) for real Mobile OTP SMS delivery.
SMS_GATEWAY_API_KEY=""

# DIGILOCKER_CLIENT_ID / DIGILOCKER_CLIENT_SECRET: For authorized MeriPehchaan DigiLocker OAuth integration.
DIGILOCKER_CLIENT_ID=""
DIGILOCKER_CLIENT_SECRET=""

# UIDAI_ASA_KUA_LICENSE: Authorized UIDAI License ID for Aadhaar biometric/OTP e-KYC integration.
UIDAI_ASA_KUA_LICENSE=""
