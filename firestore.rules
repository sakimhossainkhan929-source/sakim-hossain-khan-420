rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'sakimhossaink@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // Admin collection: Read-only for admins; cannot be written directly from client
    match /admins/{adminId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }

    // Users collection: Private citizen profiles
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId
                    && request.resource.data.id == userId
                    && request.resource.data.role == 'customer';
      allow update: if isSignedIn() && isValidId(userId) && (
        isAdmin() ||
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'id']))
      );
      allow delete: if isAdmin();
    }

    // Applications collection: Citizen PAN & Scheme applications
    match /applications/{applicationId} {
      allow get: if isSignedIn() && isValidId(applicationId) && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(applicationId) && (
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isSignedIn() && isValidId(applicationId) && (
        isAdmin() || (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(notificationId) && (
        isAdmin() || request.resource.data.userId == request.auth.uid
      );
      allow update: if isSignedIn() && isValidId(notificationId) && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(notificationId) && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }
  }
}
